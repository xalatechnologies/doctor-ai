{
  "name": "doctor-ai",
  "version": "0.0.1",
  "description": "Doctor AI - AI-powered healthcare assistant",
  "author": "Ibrahim Rahmani",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npx nest start",
    "start:dev": "npx nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.config.js",
    "test:e2e:watch": "jest --config ./test/jest-e2e.config.js --watch",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v",
    "docker:prod:build": "docker-compose -f docker-compose.prod.yml build",
    "docker:prod:up": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker-compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker-compose -f docker-compose.prod.yml logs -f",
    "docker:prod:clean": "docker-compose -f docker-compose.prod.yml down -v",
    "test:perf": "jest --config ./test/performance/jest.config.js",
    "test:integration": "jest --config ./test/integration/jest.config.js",
    "test:load": "k6 run ./test/load/health.load.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.16.0",
    "@google/generative-ai": "^0.2.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/websockets": "^10.0.0",
    "@slack/web-api": "^7.8.0",
    "@supabase/supabase-js": "^2.47.10",
    "@willsoto/nestjs-prometheus": "^6.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cohere-ai": "^7.0.0",
    "ioredis": "^5.4.2",
    "node-pg-migrate": "^7.8.0",
    "nodemailer": "^6.9.16",
    "openai": "^4.0.0",
    "pdfkit": "^0.14.0",
    "redis": "^4.6.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "supertest": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.13.0",
    "@types/redis": "^4.0.11",
    "@types/ws": "^8.0.0",
    "autocannon": "^7.15.0",
    "jest": "^29.0.0",
    "k6": "^0.0.0",
    "typescript": "^5.0.0",
    "ws": "^8.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
