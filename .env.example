# Node Environment
NODE_ENV=development

# Service Ports
EMERGENCY_PORT=3001
SYMPTOM_ANALYSIS_PORT=3002
TREATMENT_PORT=3003
MONITORING_PORT=3004
ORCHESTRATOR_PORT=3000

# Database Credentials
EMERGENCY_DB_USER=user
EMERGENCY_DB_PASSWORD=password
SYMPTOM_ANALYSIS_DB_USER=user
SYMPTOM_ANALYSIS_DB_PASSWORD=password
TREATMENT_DB_USER=user
TREATMENT_DB_PASSWORD=password
MONITORING_DB_USER=user
MONITORING_DB_PASSWORD=password

# Database URLs
EMERGENCY_DB_URL=postgresql://${EMERGENCY_DB_USER}:${EMERGENCY_DB_PASSWORD}@emergency-db:5432/emergency_db
SYMPTOM_ANALYSIS_DB_URL=postgresql://${SYMPTOM_ANALYSIS_DB_USER}:${SYMPTOM_ANALYSIS_DB_PASSWORD}@symptom-analysis-db:5432/symptom_db
TREATMENT_DB_URL=postgresql://${TREATMENT_DB_USER}:${TREATMENT_DB_PASSWORD}@treatment-db:5432/treatment_db
MONITORING_DB_URL=postgresql://${MONITORING_DB_USER}:${MONITORING_DB_PASSWORD}@monitoring-db:5432/monitoring_db

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672 