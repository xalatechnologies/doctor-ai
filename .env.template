# Node Environment
NODE_ENV=development

#######################
# Service Configuration
#######################

# Service Ports
EMERGENCY_PORT=3001
SYMPTOM_ANALYSIS_PORT=3002
TREATMENT_PORT=3003
MONITORING_PORT=3004
ORCHESTRATOR_PORT=3000

# Metrics Configuration
METRICS_ENABLED=true
METRICS_PREFIX=doctor_ai

#######################
# Database Configuration
#######################

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

#######################
# Message Queue
#######################

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672

#######################
# LLM Configuration
#######################

# Default LLM Provider
LLM_DEFAULT_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_RATE_LIMIT_REQUESTS=3
OPENAI_RATE_LIMIT_INTERVAL=1000

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_key
AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com
AZURE_OPENAI_MODEL=gpt-4
AZURE_OPENAI_MAX_TOKENS=2000
AZURE_RATE_LIMIT_REQUESTS=10
AZURE_RATE_LIMIT_INTERVAL=1000

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_key
ANTHROPIC_MODEL=claude-2
ANTHROPIC_MAX_TOKENS=2000
ANTHROPIC_RATE_LIMIT_REQUESTS=5
ANTHROPIC_RATE_LIMIT_INTERVAL=1000

# Google Med-PaLM 2 Configuration
GOOGLE_PROJECT_ID=your_google_project_id
GOOGLE_LOCATION=us-central1
GOOGLE_PALM_MODEL=medpalm2-large
GOOGLE_PALM_MAX_TOKENS=2048
GOOGLE_PALM_RATE_LIMIT_REQUESTS=10
GOOGLE_PALM_RATE_LIMIT_INTERVAL=1000

# Google Gemini Configuration
GOOGLE_GEMINI_API_KEY=your_gemini_key
GOOGLE_GEMINI_MODEL=gemini-pro
GOOGLE_GEMINI_MAX_TOKENS=2048
GOOGLE_GEMINI_RATE_LIMIT_REQUESTS=10
GOOGLE_GEMINI_RATE_LIMIT_INTERVAL=1000

# Deepseek Configuration
DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-coder-33b-instruct
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_RATE_LIMIT_REQUESTS=5
DEEPSEEK_RATE_LIMIT_INTERVAL=1000 